{
  "name": "psychotic-love",
  "compatibility_date": "2026-08-05",
  // Enabled: this Worker now handles real authentication (VIP gate), so
  // production error visibility matters more than the local dev-loop
  // annoyance below. Locally, observability's trace-store SQLite file lives
  // inside the watched assets directory ("."), and wrangler dev's file
  // watcher can treat writes to it as a source change, triggering extra
  // reloads -- an acceptable local-only trade during development.
  "observability": { "enabled": true },
  "main": "worker/index.js",
  // run_worker_first: by default Cloudflare's static-assets layer serves a
  // matching file (like /vip -> vip.html) directly, without ever invoking
  // the Worker's fetch() handler -- which silently bypassed the gate check
  // entirely. Scoping this to just the gated paths keeps every other page
  // on the fast direct-asset-serving path.
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/vip", "/vip.html", "/product", "/product.html"] },
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "VIP_MEMBERS", "id": "f940257ce27642caaf93e981d8316fd3", "preview_id": "a9c0dbb59bcb48a1b755d1915821bc87" },
    { "binding": "DISCOUNT_REDEMPTIONS", "id": "84fe9d47fadd47a68443ea1a5c516066", "preview_id": "e7424c3466304bf3ad324c36b00fa144" }
  ]
}
